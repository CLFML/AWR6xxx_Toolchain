# Prerequisites
*.d

# Python bytecode cache (from running/importing cmake/*.py directly)
__pycache__/
*.pyc
.mypy_cache/

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
# Kernel .cmd files are always dot-prefixed (e.g. .foo.o.cmd) -- a bare
# "*.cmd" also matches TI linker command files like linker_awr6843.cmd,
# which are checked-in source, not build output.
.*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf
